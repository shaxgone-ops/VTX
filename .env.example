# ======================================================
# VTX Earn Arena — Environment Variables
# ======================================================
# Copy to .env and fill in your values.
# On Render.com → Settings → Environment → paste each key.
# ======================================================

# ── Telegram Bot ──────────────────────────────────────
BOT_TOKEN=your_bot_token_from_botfather
WEBHOOK_BASE_URL=https://vtx-px5f.onrender.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=your_random_secret_string

# ── Database ──────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://user:pass@host/dbname

# ── URLs ──────────────────────────────────────────────
FRONTEND_PUBLIC_URL=https://vtx-frontent.onrender.com
BACKEND_PUBLIC_URL=https://vtx-px5f.onrender.com

# ── Access Control ────────────────────────────────────
ADMIN_IDS=6735799833
VIP_IDS=
WHITELIST_ONLY=false

# ── Token Branding ────────────────────────────────────
TOKEN_NAME=VTX Coin
TOKEN_SYMBOL=VTX
APP_NAME=VTX Earn Arena

# ── Image URLs (leave empty for auto-fallback) ────────
TOKEN_LOGO_URL=
COVER_IMAGE_URL=
VIP_IMAGE_URL=
MARKET_IMAGE_URL=
QUEST_IMAGE_URL=

# ── Gameplay ──────────────────────────────────────────
INITIAL_STAMINA=200
STAMINA_REGEN_PER_MIN=10
MAX_TAP_PER_SECOND=6
BASE_PROFIT_PER_HOUR=150
VIP_PROFIT_MULTIPLIER=3.5
DAILY_COMBO_REWARD=100000
DAILY_CIPHER_REWARD=50000

# ── Rewards ───────────────────────────────────────────
REFERRAL_REWARD=120
DAILY_ACTIVE_REWARD=75

# ── Broadcast ─────────────────────────────────────────
BROADCAST_INTERVAL_HOURS=24

# ── Market ────────────────────────────────────────────
MARKET_BUY_FEE_BPS=15
MARKET_SELL_FEE_BPS=25

# ── Airdrop ───────────────────────────────────────────
AIRDROP_REWARD_MIN=10000
AIRDROP_REWARD_MAX=300000
AIRDROP_TOKEN_SYMBOL=ADX

# ── Admin API ─────────────────────────────────────────
ADMIN_API_TOKEN=your_admin_api_secret

# ── Exchange (optional) ───────────────────────────────
ENABLED_EXCHANGES=binance,bybit
EXCHANGE_API_BASE=https://api.binance.com
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── Production ────────────────────────────────────────
ENVIRONMENT=production
PYTHON_VERSION=3.11.9
